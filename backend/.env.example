# HealForge backend configuration — COPY to backend/.env and fill in.
# NEVER commit real secrets. NEVER put API keys in VITE_* variables (those are bundled into the browser).

# --- Database (Supabase PostgreSQL / Local SQLite) -------------------------
# Path A: Local Supabase dev instance (15 canonical tables via Supabase CLI):
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SCHEMA=public
SKIP_ALEMBIC_MIGRATIONS=true

# Path B: Hosted Supabase Project (e.g. healforge-dev):
# DATABASE_URL=postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_SCHEMA=public
# SKIP_ALEMBIC_MIGRATIONS=true

# Path C: Local standalone SQLite (fast isolated development without Docker):
# DATABASE_URL=sqlite:///./healforge.db
# SKIP_ALEMBIC_MIGRATIONS=false

# Supabase Platform Connection
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Provider (Nebius Token Factory / NVIDIA NIM) ------------------------
# Choose provider: 'nebius' (default) or 'nvidia'
AI_PROVIDER=nebius

# Nebius Token Factory (Server-side secret only)
# Endpoint: https://api.tokenfactory.nebius.com/v1
# Obtain key at: https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
NEBIUS_TIMEOUT_SECONDS=60
NEBIUS_MAX_OUTPUT_TOKENS=2048

# NVIDIA NIM / API Catalog (Alternative provider)
# Obtain from NVIDIA API Catalog (https://build.nvidia.com). Server-side only.
# Without a key, model-backed actions return an honest "not configured" state.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_MAX_OUTPUT_TOKENS=2048

# --- Auth -------------------------------------------------------------------
# Single-user development mode: the backend auto-provisions the default workspace
# owner on first request. FAIL CLOSED: the default is false; production deployments
# REFUSE TO START with this enabled unless the explicit escape hatch below is set.
# Set HEALFORGE_SINGLE_USER=true only for local single-developer use.
HEALFORGE_SINGLE_USER=false
HEALFORGE_DEFAULT_USER_EMAIL=dev@healforge.local
SESSION_TTL_HOURS=168

# Deployment mode: local | production. Production enables startup guards:
# - single-user bootstrap + production => REFUSES TO START (shared unauthenticated
#   owner account must never be exposed publicly)
# - in-process jobs + production => loud durability warning
HEALFORGE_ENV=local
# Explicit operator opt-in to allow single-user bootstrap in production anyway
# (NOT recommended — any visitor becomes the workspace owner).
HEALFORGE_ALLOW_SINGLE_USER_IN_PRODUCTION=false

# --- Background jobs ---------------------------------------------------------
# Only 'in_process' is supported today: scan jobs run in an in-process thread
# pool. HONEST LIMIT: jobs interrupted by a restart are marked failed (never
# silently resumed); use POST /api/v1/scans/{id}/retry to re-queue. Durable
# production queues require a real broker (e.g. Celery + RabbitMQ) — see README.
JOB_BACKEND=in_process

# --- Verification runner ----------------------------------------------------
# Execution-based verification is HARD-DISABLED unless an isolated, ephemeral
# runner has been independently verified (gVisor or equivalent). There is NO
# host fallback. Leave false unless you have proven isolation.
RUNNER_VERIFIED=false

# --- Upload limits ------------------------------------------------------------
MAX_ARCHIVE_BYTES=20971520
MAX_ARCHIVE_ENTRIES=500
MAX_FILE_BYTES=262144
MAX_TOTAL_TEXT_BYTES=8388608

# --- CORS ----------------------------------------------------------------------
# Exact origins only (no wildcards with credentials). Frontend dev origin:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional static analysis engine -------------------------------------------
# If installed (`pipx install semgrep`), HealForge uses it as a secondary
# engine with a local ruleset. Absent is fine — the built-in engine is primary.
SEMGREP_AVAILABLE=false
