# =============================================================================
# HealForge — root environment template (docker-compose / deployment).
# COPY to `.env` at the project root and fill in real values.
# NEVER commit the real .env. NEVER put API keys in VITE_* variables
# (everything prefixed VITE_ is bundled into the browser).
# =============================================================================

# --- PostgreSQL (used by docker-compose deployments) ------------------------
POSTGRES_USER=healforge
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=healforge
POSTGRES_PORT=5432

# --- Database Configuration (Choose ONE of the three paths below) ------------
#
# Path A: Local Supabase CLI (Recommended local dev with 15 canonical tables)
# Start Supabase CLI first (`npx supabase start`).
#   - For host-run backend (uvicorn / dev.sh): port 54322 on 127.0.0.1
#   - For Docker Compose backend: port 54322 on host.docker.internal
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SCHEMA=public
SKIP_ALEMBIC_MIGRATIONS=true
# (If running backend in Docker Compose with host Supabase CLI, uncomment below):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:54322/postgres
#
# Path B: Hosted Supabase Project (e.g. healforge-dev)
# Connects to authoritative public schema. Alembic migrations are suppressed.
# DATABASE_URL=postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_SCHEMA=public
# SKIP_ALEMBIC_MIGRATIONS=true
#
# Path C: Standalone Docker Compose PostgreSQL (Built-in container, no Supabase)
# Uses the built-in postgres container. Alembic migrations MUST run to populate tables.
# DATABASE_URL=postgresql+psycopg://healforge:CHANGE_ME_STRONG_PASSWORD@postgres:5432/healforge
# DATABASE_SCHEMA=healforge_backend
# SKIP_ALEMBIC_MIGRATIONS=false

# Supabase Platform Connection & JWT Verification
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Provider (Nebius Token Factory / NVIDIA NIM) ------------------------
# Choose provider: 'nebius' (hackathon default) or 'nvidia'
AI_PROVIDER=nebius

# Nebius Token Factory (Server-side secret only)
# Endpoint: https://api.tokenfactory.nebius.com/v1
# Obtain key at: https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
NEBIUS_TIMEOUT_SECONDS=60
NEBIUS_MAX_OUTPUT_TOKENS=2048

# NVIDIA-hosted NIM inference (Alternative provider)
# Get a key at https://build.nvidia.com (NVIDIA API Catalog).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_MAX_OUTPUT_TOKENS=2048

# Auth
HEALFORGE_SINGLE_USER=false          # true = auto-provision one shared dev user.
                                     # FAIL CLOSED: keep false for any real deployment;
                                     # the backend REFUSES to start with
                                     # HEALFORGE_SINGLE_USER=true while HEALFORGE_ENV=production
                                     # (unless HEALFORGE_ALLOW_SINGLE_USER_IN_PRODUCTION=true is
                                     # also set — not recommended).
HEALFORGE_ENV=production             # local | production (deployment guards key off this)
HEALFORGE_DEFAULT_USER_EMAIL=dev@healforge.local
SESSION_TTL_HOURS=168

# Execution-based verification stays HARD-DISABLED until an isolated, ephemeral
# runner (gVisor or equivalent) is actually deployed and proven. NO host fallback.
RUNNER_VERIFIED=false

# Upload safety limits (bytes / entry counts)
MAX_ARCHIVE_BYTES=20971520
MAX_ARCHIVE_ENTRIES=500
MAX_FILE_BYTES=262144
MAX_TOTAL_TEXT_BYTES=8388608

# CORS — exact origins only (credentials are used, so no wildcards).
# In compose the frontend is served by nginx; set it to your real public origin(s).
CORS_ORIGINS=http://localhost:8080

# Optional secondary static engine (installed via `pipx install semgrep`)
SEMGREP_AVAILABLE=false
